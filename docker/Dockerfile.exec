# Build from the repository root: docker build -f docker/Dockerfile.exec .
#
# The image's Python packages come from uv.lock (the "exec" dependency group in
# pyproject.toml), so the server and the sandbox run the same versions and the supply-chain
# scan covers both (D1). Images are pinned by digest for reproducible, reviewable updates.

# Stage 1: export the locked "exec" group, with hashes, as a pip requirements file.
FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS requirements
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN ["/uv", "export", "--frozen", "--only-group", "exec", "--no-emit-project", \
     "--format", "requirements-txt", "--output-file", "/requirements-exec.txt"]

# Stage 2: the execution image.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

# --require-hashes: only the locked artifacts. --no-deps: the export is already complete.
# --only-binary: the slim image has no compiler, so a package without a CPython 3.15 wheel
# fails here instead of attempting a source build.
COPY --from=requirements /requirements-exec.txt /tmp/requirements-exec.txt
RUN python -m pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: \
        -r /tmp/requirements-exec.txt \
    && rm /tmp/requirements-exec.txt

# Fixed unprivileged identity for running the image by hand. The backend always passes an
# explicit non-root --user (the server's own uid:gid, or docker_user) and refuses uid 0.
RUN groupadd --gid 10001 analytics \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp \
       --shell /usr/sbin/nologin analytics

WORKDIR /workspace
USER 10001:10001
CMD ["python", "-c", "import time; time.sleep(2147483647)"]
