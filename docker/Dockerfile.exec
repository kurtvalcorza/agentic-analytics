# Pinned by digest for reproducible, reviewable base-image updates (bump deliberately).
FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

RUN python -m pip install --no-cache-dir \
    duckdb==1.5.5 \
    matplotlib==3.11.1 \
    numpy==2.5.2 \
    pandas==3.0.5 \
    pyarrow==23.0.1 \
    scikit-learn==1.9.0 \
    scipy==1.18.0 \
    statsmodels==0.14.6

# Fixed unprivileged identity. The backend always passes an explicit non-root --user (the
# server's own uid:gid on POSIX hosts, this identity elsewhere) and refuses uid 0.
RUN groupadd --gid 10001 analytics \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp \
       --shell /usr/sbin/nologin analytics

WORKDIR /workspace
USER 10001:10001
CMD ["python", "-c", "import time; time.sleep(2147483647)"]
